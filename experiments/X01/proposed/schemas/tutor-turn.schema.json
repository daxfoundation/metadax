{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadax.daxfoundation.org/schemas/0.3/tutor-turn.schema.json",
  "title": "metadax.tutor-turn/0.3",
  "description": "Proposed v0.3: adds stuck_signature, chain_position and technique_ref so a tutor turn can record which canonical confusion it diagnosed, who made the move, and which captured technique it applied (B18). Diff vs 0.2 is limited to these three additions; all 0.2 fields are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "state", "next_action"],
  "properties": {
    "schema": { "const": "metadax.tutor-turn/0.3" },
    "type": { "enum": ["intro", "question", "feedback", "handoff", "summary", "error"] },
    "stuck_signature": {
      "anyOf": [ { "$ref": "#/$defs/stuckSignature" }, { "type": "null" } ],
      "description": "NEW in 0.3. The canonical learner-confusion category this turn diagnosed, or null if none. Retrieval key against technique records."
    },
    "chain_position": {
      "anyOf": [ { "$ref": "#/$defs/chainRole" }, { "type": "null" } ],
      "description": "NEW in 0.3. Who/what made this move — tutor (human) vs model (model-played hint) etc. Without it a human move and a model hint are indistinguishable."
    },
    "technique_ref": {
      "anyOf": [ { "$ref": "#/$defs/techniqueRef" }, { "type": "null" } ],
      "description": "NEW in 0.3. If this turn applied a captured technique, a reference to it: the technique id, whether it was minted on this turn or reused, and the language it was reused across."
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": { "type": "string" },
        "instructions": { "type": "string" },
        "example": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concept": { "$ref": "#/$defs/conceptId" },
        "bloom_level": { "$ref": "#/$defs/bloom" },
        "question_type": { "$ref": "#/$defs/questionType" },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": { "anyOf": [ { "enum": ["correct", "partial", "incorrect"] }, { "type": "null" } ] },
        "hint": { "type": "string" },
        "correct_answer": { "type": "string" },
        "explanation": { "type": "string" },
        "misconception": { "type": "string" }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": { "type": "string" },
        "node_id": { "$ref": "#/$defs/nodeId" },
        "section_id": { "$ref": "#/$defs/sectionId" },
        "anchor_quote": { "type": "string", "maxLength": 200 },
        "learner_question": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concepts": { "type": "array", "items": { "$ref": "#/$defs/summaryConcept" } },
        "strengths": { "type": "array", "items": { "type": "string" } },
        "areas_for_improvement": { "type": "array", "items": { "type": "string" } },
        "misconceptions": { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "encouragement": { "type": "string" }
      }
    },
    "state": { "$ref": "#/$defs/state" },
    "next_action": { "enum": ["awaiting_answer", "awaiting_command", "done"] },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "missing": { "type": "array", "items": { "type": "string" } },
    "message": { "type": "string" }
  },
  "$defs": {
    "stuckSignature": {
      "enum": [
        "cancellation-fallacy",
        "attribute-to-wrong-owner",
        "conflated-entities",
        "magnitude-over-rule",
        "reversed-relation",
        "overgeneralized-rule",
        "missing-intermediate-step",
        "symbol-literalism",
        "scale-insensitivity",
        "boundary-neglect"
      ]
    },
    "chainRole": { "enum": ["tutor", "model", "author", "learner", "curator"] },
    "techniqueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technique_id", "disposition"],
      "properties": {
        "technique_id": { "type": "string", "maxLength": 200, "pattern": "^t_[0-9a-hjkmnp-tv-z]{26}$" },
        "disposition": {
          "enum": ["minted", "reused"],
          "description": "minted = this turn created the technique record; reused = it retrieved an existing one."
        },
        "reused_across_language": {
          "type": "boolean",
          "description": "True if the technique was minted in one language and reused in another on this turn."
        },
        "origin_language": { "type": "string", "maxLength": 35, "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$" }
      }
    },
    "conceptId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "nodeId": { "type": "string", "maxLength": 200, "pattern": "^(L\\d\\d\\.M\\d\\d\\.O\\d\\d|n_[0-9a-hjkmnp-tv-z]{26})$" },
    "sectionId": { "type": "string", "pattern": "^s\\d+$" },
    "bloom": { "enum": ["Remember", "Understand", "Apply", "Analyze", "Evaluate", "Create"] },
    "levelStatus": { "enum": ["not_started", "passed_first_try", "passed_after_help", "failed", "skipped"] },
    "questionType": { "enum": ["True/False", "Multiple Choice", "Matching", "Fill-in-the-Blanks", "Binary Choice", "Short Answer (explain in own words)", "Categorization", "Cloze", "Numeric/Calculation", "Short Answer (practical use)", "Completion", "Short Problem-Solving", "Ordering/Sequencing", "Assertion-Reason", "Ranking", "Short Answer (analytical)", "Short Answer (critical judgement)", "Short Essay (1 paragraph)", "Ranking with justification", "Essay or Design", "Open-Ended Completion"] },
    "warning": { "enum": ["steer_conflict", "audience_conflict", "out_of_scope", "depth_limit", "low_confidence", "source_gap", "wellbeing_flag", "missing_input", "orphans_followups", "budget_unmet", "unstamped"] },
    "summaryConcept": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/conceptId" },
        "name": { "type": "string" },
        "competency": { "type": "integer", "minimum": 0, "maximum": 100 },
        "levels": { "type": "object", "additionalProperties": { "$ref": "#/$defs/levelStatus" } }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_order", "concept", "level", "attempt", "help_used", "hints_given", "phase", "levels", "competency"],
      "properties": {
        "concept_order": { "type": "array", "items": { "$ref": "#/$defs/conceptId" } },
        "concept": { "$ref": "#/$defs/conceptId" },
        "level": { "$ref": "#/$defs/bloom" },
        "attempt": { "type": "integer", "minimum": 1 },
        "help_used": { "type": "boolean" },
        "hints_given": { "enum": [0, 1, 2] },
        "phase": { "enum": ["main", "remedial"] },
        "levels": {
          "type": "object",
          "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/levelStatus" } }
        },
        "competency": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
