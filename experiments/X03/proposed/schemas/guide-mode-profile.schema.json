{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "metadax.guide-mode-profile",
  "title": "Guide-Mode Profile",
  "description": "Declares, per stage, who owns it and what the system may and may not do.",
  "type": "object",
  "required": ["guide_id", "module_id", "stages", "system_can", "system_cannot"],
  "additionalProperties": false,
  "properties": {
    "guide_id": {
      "type": "string",
      "description": "Opaque identifier for the guide."
    },
    "module_id": {
      "type": "string",
      "description": "Module this profile applies to."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage_id", "owner", "description"],
        "additionalProperties": false,
        "properties": {
          "stage_id": { "type": "string" },
          "owner": {
            "type": "string",
            "enum": ["guide", "guide+system", "system"],
            "description": "Who drives this stage."
          },
          "description": { "type": "string" },
          "system_note": {
            "type": "string",
            "description": "Optional constraint the guide adds for this stage only."
          }
        }
      }
    },
    "system_can": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit permissions the system has in this session."
    },
    "system_cannot": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Hard prohibitions — the system must yield or surface these as errors."
    }
  }
}
