{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metadax.daxfoundation.org/schemas/0.3/context-profile.schema.json",
  "title": "metadax.context-profile/0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "name", "description", "reading_level", "tone", "session",
    "guide_role", "age_bands", "assessment_style", "delivery_media", "privacy",
    "language_note", "what_if_wrong"
  ],
  "properties": {
    "schema": { "const": "metadax.context-profile/0.3" },
    "id": { "$ref": "#/$defs/profileId" },
    "name": { "type": "string", "maxLength": 80 },
    "description": { "type": "string" },
    "reading_level": { "$ref": "#/$defs/readingLevel" },
    "tone": { "type": "string" },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes"],
      "properties": {
        "minutes": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      }
    },
    "guide_role": { "enum": ["parent", "caregiver", "teacher", "trainer", "peer", "mentor", "none"] },
    "age_bands": { "type": "array", "items": { "$ref": "#/$defs/ageBand" } },
    "assessment_style": { "type": "string" },
    "delivery_media": {
      "type": "array",
      "items": { "enum": ["screen", "print", "audio", "video", "offline", "low-bandwidth", "hands-on"] }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minors", "visibility_default"],
      "properties": {
        "minors": { "type": "boolean" },
        "visibility_default": { "enum": ["private", "pending_review", "shared"] },
        "consent_notes": { "type": "string" }
      }
    },
    "language_note": { "type": "string" },
    "defaults_for": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "MP-11": { "type": "object" },
        "MP-02": { "type": "object" },
        "MP-04": { "type": "object" }
      }
    },
    "supports": { "type": "array", "items": { "type": "string" } },
    "what_if_wrong": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "profileId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "readingLevel": {
      "enum": [
        "plain-language", "grade-1", "grade-2", "grade-3", "grade-4", "grade-5",
        "grade-6", "grade-7", "grade-8", "grade-9", "grade-10", "grade-11",
        "grade-12", "adult"
      ]
    },
    "ageBand": { "enum": ["4-6", "7-9", "10-12", "13-15", "16-18", "adult", "unknown"] }
  }
}
